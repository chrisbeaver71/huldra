# Huldra Hermes V1 -- trimmed secret-free .env example
# Copy to your Huldra HERMES_HOME .env and fill values. NEVER commit real secrets.
# Do NOT copy live %LOCALAPPDATA%\hermes\.env into ops.

# --- Paths (Huldra product defaults) ---
# HERMES_HOME should be a Huldra-isolated home for smoke, e.g.:
#   $env:HULDRA_HOME\huldra-hermes-prep-home
# Never set this to Project LATCH or profiles/latch.
# HULDRA_ROOT=%HULDRA_HOME%
# HULDRA_BOARDS=%HULDRA_HOME%/boards/huldra
# HULDRA_STATUS=%HULDRA_HOME%/.hermes-live

# --- Slack (#huldra only) ---
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=
# Home / coordination channel: #huldra / C0BKR5LEYV8 (NOT #latch / C0BKT3BEP4H)

# --- LLM (pick one; leave others blank) ---
# OPENROUTER_API_KEY=
# COMMANDCODE_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional local ---
# Ollama at http://127.0.0.1:11434/v1 needs no key when running locally.

# Debug (safe defaults)
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
